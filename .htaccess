DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: HTTPS without www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.brunomoya\.com$ [NC]
  RewriteRule ^ https://brunomoya.com%{REQUEST_URI} [R=301,L]

  # Markdown for Agents: a request carrying `Accept: text/markdown` gets the page's
  # markdown twin (index.md, written by scripts/markdown-pages.js); a browser, which never
  # sends that media type, gets the HTML it always got. This lives in .htaccess rather than
  # in the HestiaCP nginx templates because nginx hands every extension-less route straight
  # to Apache, and because .htaccess needs no root and survives v-rebuild-web-domains.
  # Must stay ahead of the -f/-d rule below, which would otherwise serve the directory.
  #   /        -> /index.md          /resume/ -> /resume/index.md
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.md -f
  RewriteRule ^ %{REQUEST_URI}index.md [L]
  # mod_dir already 301s /resume to /resume/, which then negotiates, so this second rule
  # is only a safety net for the day DirectorySlash is turned off.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.md -f
  RewriteRule ^ %{REQUEST_URI}/index.md [L]

  # Serve generated pages and machine-readable resources directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Anything left is genuinely missing, so Apache falls through to the 404 below. There is
  # deliberately no catch-all to index.html: the React app has no path-based client routes
  # (its only navigation is ?skill=...#projects on the current path), so a catch-all served
  # 200 + HTML to WordPress probes, /.well-known/ lookups and stale Vite asset URLs alike -
  # telling agents that everything exists, and turning a half-finished deploy into a blank
  # page instead of a loud error.
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType text/plain .txt
  AddType "text/markdown; charset=utf-8" .md
  AddType application/xml .xml
  AddType application/pdf .pdf
</IfModule>

# Token estimates for x-markdown-tokens, one line per markdown twin. Apache cannot count
# tokens, so the build writes these; regenerated by scripts/generate-professional-pages.js.
# MARKDOWN_TOKENS_START
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/en/?(index\.md)?$" MD_TOKENS=1719 MD_HREF=/en/index.md
  SetEnvIf Request_URI "^/en/resume/?(index\.md)?$" MD_TOKENS=4080 MD_HREF=/en/resume/index.md
  SetEnvIf Request_URI "^/en/experience/?(index\.md)?$" MD_TOKENS=1001 MD_HREF=/en/experience/index.md
  SetEnvIf Request_URI "^/en/projects/?(index\.md)?$" MD_TOKENS=643 MD_HREF=/en/projects/index.md
  SetEnvIf Request_URI "^/en/projects/jobagent/?(index\.md)?$" MD_TOKENS=525 MD_HREF=/en/projects/jobagent/index.md
  SetEnvIf Request_URI "^/en/projects/talent-gap-analyzer/?(index\.md)?$" MD_TOKENS=447 MD_HREF=/en/projects/talent-gap-analyzer/index.md
  SetEnvIf Request_URI "^/en/projects/glassear-studio/?(index\.md)?$" MD_TOKENS=464 MD_HREF=/en/projects/glassear-studio/index.md
  SetEnvIf Request_URI "^/en/projects/mapanim/?(index\.md)?$" MD_TOKENS=487 MD_HREF=/en/projects/mapanim/index.md
  SetEnvIf Request_URI "^/?(index\.md)?$" MD_TOKENS=1696 MD_HREF=/index.md
  SetEnvIf Request_URI "^/resume/?(index\.md)?$" MD_TOKENS=4189 MD_HREF=/resume/index.md
  SetEnvIf Request_URI "^/experience/?(index\.md)?$" MD_TOKENS=1033 MD_HREF=/experience/index.md
  SetEnvIf Request_URI "^/projects/?(index\.md)?$" MD_TOKENS=667 MD_HREF=/projects/index.md
  SetEnvIf Request_URI "^/projects/jobagent/?(index\.md)?$" MD_TOKENS=550 MD_HREF=/projects/jobagent/index.md
  SetEnvIf Request_URI "^/projects/talent-gap-analyzer/?(index\.md)?$" MD_TOKENS=461 MD_HREF=/projects/talent-gap-analyzer/index.md
  SetEnvIf Request_URI "^/projects/glassear-studio/?(index\.md)?$" MD_TOKENS=481 MD_HREF=/projects/glassear-studio/index.md
  SetEnvIf Request_URI "^/projects/mapanim/?(index\.md)?$" MD_TOKENS=455 MD_HREF=/projects/mapanim/index.md
</IfModule>
# MARKDOWN_TOKENS_END

<IfModule mod_headers.c>
  # Both representations must carry this, or a cache in front of the site can hand a
  # browser the markdown. merge, not set: mod_deflate already puts Accept-Encoding here.
  Header merge Vary "Accept"

  # RFC 8288 discovery: name the machine-readable layer in the headers, so an agent finds
  # it without parsing HTML. Only relations registered with IANA, and only for resources
  # that exist - an invented api-catalog would be worse than no header at all.
  <FilesMatch "\.(html|md)$">
    Header always add Link "</llms.txt>; rel=\"service-doc\"; type=\"text/plain\""
    Header always add Link "</profile.json>; rel=\"describedby\"; type=\"application/json\""
    # Per-page, from the same SetEnvIf block that carries the token count.
    Header always add Link "<%{MD_HREF}e>; rel=\"alternate\"; type=\"text/markdown\"" env=MD_HREF
  </FilesMatch>

  <FilesMatch "\.md$">
    Header set x-markdown-tokens "%{MD_TOKENS}e" env=MD_TOKENS
  </FilesMatch>
  <FilesMatch "\.(pdf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  <FilesMatch "\.(json|txt|md|xml)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

# Compress text responses; already-compressed images and fonts are excluded.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Only Vite content-hashed assets are immutable.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
