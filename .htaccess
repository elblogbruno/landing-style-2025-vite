DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: HTTPS without www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.brunomoya\.com$ [NC]
  RewriteRule ^ https://brunomoya.com%{REQUEST_URI} [R=301,L]

  # Retired standalone pages now lead to sections of the same landing.
  RewriteRule ^(en/)?projects/glassear-studio(?:/.*)?$ https://glassear.com/studio/ [R=301,L]
  RewriteRule ^(en/)?projects(?:/.*)?$ /$1#projects [R=301,L,NE]
  RewriteRule ^(en/)?(?:resume|experience)(?:/.*)?$ /$1#experience [R=301,L,NE]

  # Only the landing has a Markdown representation; retired HTML pages stay retired.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^(en/)?(?:index\.html)?$ /$1index.md [L]

  # Serve the landing assets and legacy versions directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Anything left is genuinely missing, so Apache falls through to the 404 below. There is
  # deliberately no catch-all to index.html: the React app has no path-based client routes
  # (its only navigation is ?skill=...#projects on the current path), so a catch-all served
  # 200 + HTML to WordPress probes, /.well-known/ lookups and stale Vite asset URLs alike -
  # telling agents that everything exists, and turning a half-finished deploy into a blank
  # page instead of a loud error.
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType text/plain .txt
  AddType "text/markdown; charset=utf-8" .md
  AddType application/xml .xml
  AddType application/pdf .pdf
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(en/)?(index\.html)?$" LANDING_PAGE=1
  SetEnvIf Request_URI "^/(en/)?(index\.md|profile\.json|llms(-full)?\.txt|resume\.md|projects\.md)$" AGENT_FILE=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex" env=AGENT_FILE
  Header merge Vary "Accept" env=LANDING_PAGE
  Header always add Link "</llms.txt>; rel=\"service-doc\"; type=\"text/plain\"" env=LANDING_PAGE
  Header always add Link "</profile.json>; rel=\"describedby\"; type=\"application/json\"" env=LANDING_PAGE
  <FilesMatch "\.(pdf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  <FilesMatch "\.(json|txt|md|xml)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

# Compress text responses; already-compressed images and fonts are excluded.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Only Vite content-hashed assets are immutable.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
